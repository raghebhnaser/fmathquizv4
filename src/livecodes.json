{
  "title": "RacingBars",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>تحدي العباقرة - قناة وسام التعليمية</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@900&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --bg-color: #000000; --card-bg: #111; --text-main: white;\n            --accent-color: #00ffff; --sec-color: #ff00ff; --quest-color: #fefe00;\n        }\n        /* الثيمات */\n        body.theme-light { --bg-color: #FFFAF0; --card-bg: #ffffff; --text-main: #2D3436; --accent-color: #0984E3; --sec-color: #E84393; --quest-color: #e67e22; }\n        body.theme-galaxy { --bg-color: #0f0c29; --card-bg: rgba(255, 255, 255, 0.1); --text-main: #ffffff; --accent-color: #a29bfe; --sec-color: #00d2ff; --quest-color: #55efc4; }\n        body.theme-kids-mickey { --bg-color: #ff0000; --card-bg: #fff; --text-main: #000; --accent-color: #fefe00; --sec-color: #000; --quest-color: #fff; }\n        body.theme-kids-neon { --bg-color: #00ff00; --card-bg: #000; --text-main: #fff; --accent-color: #ff00ff; --sec-color: #ffff00; --quest-color: #00ffff; }\n\n        body { \n            margin: 0; background-color: var(--bg-color); color: var(--text-main); \n            font-family: 'Cairo', sans-serif; display: flex; justify-content: center; \n            align-items: center; height: 100vh; width: 100vw; overflow: hidden; \n        }\n\n        /* شاشة الإعدادات */\n        #setup-screen { \n            background: var(--card-bg); padding: 15px; border-radius: 20px; border: 5px solid var(--accent-color); \n            text-align: center; width: 90%; max-width: 500px; max-height: 85vh; overflow-y: auto; \n        }\n\n        .tab-header { display: flex; gap: 5px; margin-bottom: 15px; background: rgba(0,0,0,0.2); border-radius: 10px; padding: 5px; }\n        .tab-btn { flex: 1; padding: 8px; border: none; border-radius: 8px; cursor: pointer; font-family: 'Cairo'; font-weight: bold; background: #eee; }\n        .tab-btn.active { background: var(--accent-color); color: #000; }\n        .tab-content { display: none; }\n        .tab-content.active { display: block; }\n\n        .input-group { margin-bottom: 10px; text-align: right; }\n        label { display: block; margin-bottom: 2px; color: var(--sec-color); font-weight: bold; font-size: 0.9rem; }\n        select, input { width: 100%; padding: 8px; border-radius: 10px; border: 1px solid #ccc; font-family: 'Cairo'; box-sizing: border-box; }\n        \n        .manual-q-box { background: rgba(0,0,0,0.05); padding: 10px; border-radius: 10px; margin-bottom: 10px; border: 1px solid var(--accent-color); }\n        .opt-row { display: grid; grid-template-columns: 30px 1fr 1fr; gap: 5px; margin-bottom: 5px; align-items: center; }\n\n        /* شاشة اللعب (Responsive) */\n        #video-screen { \n            display: none; width: 100vw; height: 100vh; flex-direction: column; \n            align-items: center; justify-content: flex-start; position: relative; \n            padding: 10px; box-sizing: border-box; border: 10px solid; \n            animation: rainbowBorder 3s linear infinite; overflow-y: auto;\n        }\n        @keyframes rainbowBorder { 0%, 100% { border-color: var(--sec-color); } 50% { border-color: var(--accent-color); } }\n        \n        #timer-box { \n            font-size: 2rem; background: var(--sec-color); color: white; \n            min-width: 70px; min-height: 70px; border-radius: 50%; \n            display: flex; justify-content: center; align-items: center; \n            border: 4px solid white; margin-bottom: 5px; flex-shrink: 0;\n        }\n\n        .question-area { \n            text-align: center; width: 100%; display: flex; flex-direction: column; \n            align-items: center; gap: 5px; flex-shrink: 0;\n        }\n\n        #question-text { \n            font-size: clamp(1.5rem, 6vw, 3.5rem); font-weight: 900; \n            color: var(--quest-color); text-shadow: 2px 2px 0px #000; margin: 0;\n        }\n\n        .watermark { \n            font-size: 0.9rem; color: var(--text-main); opacity: 0.8; \n            background: rgba(0,0,0,0.3); padding: 2px 12px; border-radius: 20px; \n            border: 1px solid var(--accent-color);\n        }\n\n        #q-main-img { \n            max-height: 25vh; max-width: 90%; border-radius: 12px; \n            border: 3px solid var(--accent-color); margin-top: 10px; \n            display: none; object-fit: contain; flex-shrink: 0;\n        }\n\n        .options-grid { \n            display: grid; grid-template-columns: 1fr 1fr; gap: 10px; \n            width: 100%; max-width: 800px; direction: rtl; margin-top: auto; \n            margin-bottom: 10px; padding: 10px 0;\n        }\n\n        .option-card { \n            background: var(--card-bg); border: 4px solid var(--accent-color); \n            padding: 10px; border-radius: 15px; text-align: center; \n            position: relative; display: flex; flex-direction: column; \n            align-items: center; justify-content: center; min-height: 80px; \n            box-shadow: 0 5px 0 var(--accent-color);\n        }\n\n        .opt-img-display { max-height: 70px; max-width: 100%; border-radius: 8px; margin-bottom: 5px; object-fit: contain; }\n        \n        .letter-label { \n            position: absolute; top: -10px; right: -10px; background: var(--quest-color); \n            color: #000; width: 30px; height: 30px; border-radius: 50%; \n            font-size: 1rem; display: flex; justify-content: center; \n            align-items: center; font-weight: 900; border: 2px solid white;\n        }\n\n        .correct-glow { \n            background: #00FF00 !important; color: #000 !important; \n            box-shadow: 0 0 30px #00FF00; transform: scale(1.05); z-index: 5;\n        }\n\n        /* تحسين للموبايل الصغير جداً */\n        @media (max-height: 600px) {\n            #question-text { font-size: 1.2rem; }\n            #timer-box { min-width: 50px; min-height: 50px; font-size: 1.5rem; }\n            .option-card { min-height: 60px; padding: 5px; }\n            .opt-img-display { max-height: 40px; }\n        }\n    </style>\n</head>\n<body>\n\n    <div id=\"setup-screen\">\n        <h2 style=\"color:#D63031; margin-top:0;\">🎮 إعدادات التحدي</h2>\n        <div class=\"tab-header\">\n            <button class=\"tab-btn active\" onclick=\"switchTab('math-tab', this)\">🔢 حساب تلقائي</button>\n            <button class=\"tab-btn\" onclick=\"switchTab('manual-tab', this)\">📸 صور مخصصة</button>\n        </div>\n\n        <div id=\"math-tab\" class=\"tab-content active\">\n            <div class=\"input-group\">\n                <label>العمليات:</label>\n                <div style=\"display:flex; justify-content:center; gap:10px;\">\n                    <label style=\"color:inherit\"><input type=\"checkbox\" class=\"op-check\" value=\"+\" checked> +</label>\n                    <label style=\"color:inherit\"><input type=\"checkbox\" class=\"op-check\" value=\"-\" checked> -</label>\n                    <label style=\"color:inherit\"><input type=\"checkbox\" class=\"op-check\" value=\"×\" checked> ×</label>\n                    <label style=\"color:inherit\"><input type=\"checkbox\" class=\"op-check\" value=\"÷\"> ÷</label>\n                </div>\n            </div>\n            <div class=\"input-group\">\n                <label>الصعوبة:</label>\n                <select id=\"diff-select\"><option value=\"easy\">سهل</option><option value=\"medium\" selected>متوسط</option><option value=\"hard\">صعب</option></select>\n            </div>\n            <div class=\"input-group\"><label>عدد الأسئلة:</label><input type=\"number\" id=\"math-count\" value=\"5\"></div>\n        </div>\n\n        <div id=\"manual-tab\" class=\"tab-content\">\n            <div id=\"manual-container\"></div>\n            <button onclick=\"addManualQ()\" style=\"width:100%; padding:8px; background:var(--accent-color); border:none; border-radius:8px; font-weight:bold; cursor:pointer;\">➕ أضف سؤالاً</button>\n        </div>\n\n        <div class=\"input-group\" style=\"margin-top:10px;\">\n            <label>وقت التفكير:</label><input type=\"number\" id=\"time-input\" value=\"10\">\n            <label>الثيم:</label>\n            <select id=\"theme-select\">\n                <option value=\"default\">🌙 نيون</option>\n                <option value=\"theme-kids-mickey\">🍎 ميكي (أحمر)</option>\n                <option value=\"theme-kids-neon\">🟢 فسفوري (أخضر)</option>\n                <option value=\"theme-light\">🌈 ألوان المرح</option>\n            </select>\n        </div>\n        <button onclick=\"startChallenge()\" style=\"width:100%; padding:12px; background:#D63031; color:white; border:none; border-radius:50px; font-weight:bold; font-size:1.2rem; cursor:pointer; margin-top:10px;\">ابدأ الآن 🚀</button>\n    </div>\n\n    <div id=\"video-screen\">\n        <div id=\"timer-box\">10</div>\n        <div class=\"question-area\">\n            <div id=\"question-text\">?</div>\n            <div class=\"watermark\">قناة وسام التعليمية</div>\n            <img id=\"q-main-img\">\n        </div>\n        <div class=\"options-grid\" id=\"options-container\"></div>\n    </div>\n\n    <audio id=\"audio-tick\" src=\"https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3\"></audio>\n    <audio id=\"audio-win\" src=\"https://assets.mixkit.co/active_storage/sfx/2019/2019-preview.mp3\"></audio>\n\n    <script>\n        let mode = 'math', currentStep = 0, config = {}, manualData = [];\n\n        function speak(text) {\n            window.speechSynthesis.cancel();\n            const msg = new SpeechSynthesisUtterance(text);\n            msg.lang = 'ar-SA';\n            window.speechSynthesis.speak(msg);\n        }\n\n        function switchTab(tabId, btn) {\n            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n            document.getElementById(tabId).classList.add('active');\n            btn.classList.add('active');\n            mode = (tabId === 'math-tab') ? 'math' : 'manual';\n        }\n\n        function addManualQ() {\n            const div = document.createElement('div');\n            div.className = 'manual-q-box';\n            div.innerHTML = `\n                <input type=\"text\" placeholder=\"السؤال\" class=\"m-q-text\" style=\"margin-bottom:5px\">\n                <input type=\"file\" class=\"m-q-img\" accept=\"image/*\" style=\"font-size:0.7rem\">\n                ${[0,1,2,3].map(i => `\n                    <div class=\"opt-row\">\n                        <input type=\"checkbox\" class=\"m-is-correct\" ${i===0?'checked':''}>\n                        <input type=\"text\" placeholder=\"خيار ${i+1}\" class=\"m-opt-txt\">\n                        <input type=\"file\" class=\"m-opt-img\" accept=\"image/*\" style=\"width:70px; font-size:0.5rem\">\n                    </div>\n                `).join('')}\n            `;\n            document.getElementById('manual-container').appendChild(div);\n        }\n\n        async function startChallenge() {\n            document.body.className = document.getElementById('theme-select').value;\n            config = {\n                time: parseInt(document.getElementById('time-input').value),\n                total: mode === 'math' ? parseInt(document.getElementById('math-count').value) : 0,\n                ops: Array.from(document.querySelectorAll('.op-check:checked')).map(el => el.value),\n                diff: document.getElementById('diff-select').value\n            };\n\n            if (mode === 'manual') {\n                const boxes = document.querySelectorAll('.manual-q-box');\n                manualData = [];\n                for (let box of boxes) {\n                    let opts = [];\n                    const texts = box.querySelectorAll('.m-opt-txt');\n                    const imgs = box.querySelectorAll('.m-opt-img');\n                    const checks = box.querySelectorAll('.m-is-correct');\n                    for(let i=0; i<4; i++) {\n                        if(texts[i].value || imgs[i].files[0]) {\n                            opts.push({ text: texts[i].value, img: await toBase64(imgs[i].files[0]), isCorrect: checks[i].checked });\n                        }\n                    }\n                    manualData.push({ q: box.querySelector('.m-q-text').value, qImg: await toBase64(box.querySelector('.m-q-img').files[0]), options: opts });\n                }\n                config.total = manualData.length;\n            }\n\n            document.getElementById('setup-screen').style.display = 'none';\n            document.getElementById('video-screen').style.display = 'flex';\n            playStep();\n        }\n\n        function toBase64(file) {\n            return new Promise(res => { if(!file) return res(null); const r = new FileReader(); r.onload = e => res(e.target.result); r.readAsDataURL(file); });\n        }\n\n        function generateMath() {\n            let max = config.diff === 'easy' ? 10 : config.diff === 'medium' ? 50 : 100;\n            let op = config.ops[Math.floor(Math.random() * config.ops.length)];\n            let n1 = Math.floor(Math.random()*max)+1, n2 = Math.floor(Math.random()*max)+1, ans;\n            if(op === '+') ans = n1+n2;\n            else if(op === '-') { n1 = Math.max(n1, n2); n2 = Math.min(n1, n2); ans = n1-n2; }\n            else if(op === '×') { n1 = Math.floor(Math.random()*12); n2 = Math.floor(Math.random()*10); ans = n1*n2; }\n            else { n2 = Math.floor(Math.random()*9)+1; ans = Math.floor(Math.random()*10); n1 = n2*ans; }\n            let opts = [{t: ans, isCorrect: true}];\n            while(opts.length < 4) {\n                let f = ans + (Math.floor(Math.random()*10)-5);\n                if(f !== ans && !opts.find(o => o.t === f)) opts.push({t: f, isCorrect: false});\n            }\n            return { q: `${n1} ${op} ${n2}`, options: opts.sort(() => Math.random()-0.5) };\n        }\n\n        function playStep() {\n            if (currentStep >= config.total) {\n                document.getElementById('video-screen').innerHTML = \"<h1>🏆 أحسنت! انتهى التحدي</h1>\";\n                return;\n            }\n\n            let data;\n            if (mode === 'math') {\n                data = generateMath();\n                speak(\"كم يساوي \" + data.q.replace('×','ضرب').replace('÷','تقسيم'));\n            } else {\n                const m = manualData[currentStep];\n                data = { q: m.q, qImg: m.qImg, options: [...m.options] };\n                if(data.options.length > 1) data.options.sort(() => Math.random() - 0.5);\n                speak(data.q || \"اختر الإجابة\");\n            }\n\n            const qImgEl = document.getElementById('q-main-img');\n            document.getElementById('question-text').innerText = data.q || \"\";\n            if(data.qImg) { qImgEl.src = data.qImg; qImgEl.style.display = 'block'; } else { qImgEl.style.display = 'none'; }\n\n            const container = document.getElementById('options-container');\n            container.innerHTML = '';\n            const letters = ['أ', 'ب', 'ج', 'د'];\n\n            if(data.options.length === 1) {\n                container.style.display = 'none';\n            } else {\n                container.style.display = 'grid';\n                data.options.forEach((opt, i) => {\n                    const card = document.createElement('div');\n                    card.className = 'option-card';\n                    if(opt.isCorrect) card.classList.add('correct-ans-target');\n                    let imgPart = opt.img ? `<img src=\"${opt.img}\" class=\"opt-img-display\">` : '';\n                    card.innerHTML = `<div class=\"letter-label\">${letters[i]}</div>${imgPart}<span>${opt.text || opt.t || ''}</span>`;\n                    opt.letter = letters[i];\n                    container.appendChild(card);\n                });\n            }\n\n            let timer = config.time;\n            document.getElementById('timer-box').innerText = timer;\n            let inter = setInterval(() => {\n                timer--;\n                document.getElementById('timer-box').innerText = timer;\n                document.getElementById('audio-tick').play();\n                if(timer <= 0) {\n                    clearInterval(inter);\n                    document.getElementById('audio-win').play();\n                    if(data.options.length === 1) {\n                        container.style.display = 'flex';\n                        container.innerHTML = `<div class=\"option-card correct-glow\" style=\"width:100%; font-size:1.5rem;\"><span>${data.options[0].text}</span></div>`;\n                        speak(\"الجواب \" + data.options[0].text);\n                    } else {\n                        document.querySelectorAll('.correct-ans-target').forEach(el => el.classList.add('correct-glow'));\n                        let corrects = data.options.filter(o => o.isCorrect);\n                        let speechTxt = \"الصح هو: \";\n                        corrects.forEach(c => speechTxt += (c.text || c.t ? (c.text || c.t) : \"الخيار \" + c.letter) + \" \");\n                        speak(speechTxt);\n                    }\n                    setTimeout(() => { currentStep++; playStep(); }, 4000);\n                }\n            }, 1000);\n        }\n        addManualQ();\n    </script>\n</body>\n</html>\n"
  },
