{
  "title": "RacingBars",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\r\n<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>تحدي العباقرة - قناة وسام التعليمية</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@900&amp;display=swap\" rel=\"stylesheet\">\r\n    <style>\r\n        :root {\r\n            --bg-color: #000000; --card-bg: #111; --text-main: white;\r\n            --accent-color: #00ffff; --sec-color: #ff00ff; --quest-color: #fefe00;\r\n            --zoom-level: 1;\r\n        }\r\n        /* الثيمات */\r\n        body.theme-light { --bg-color: #FFFAF0; --card-bg: #ffffff; --text-main: #2D3436; --accent-color: #0984E3; --sec-color: #E84393; --quest-color: #e67e22; }\r\n        body.theme-galaxy { --bg-color: #0f0c29; --card-bg: rgba(255, 255, 255, 0.1); --text-main: #ffffff; --accent-color: #a29bfe; --sec-color: #00d2ff; --quest-color: #55efc4; }\r\n        body.theme-kids-mickey { --bg-color: #ff0000; --card-bg: #fff; --text-main: #000; --accent-color: #fefe00; --sec-color: #000; --quest-color: #fff; }\r\n        body.theme-kids-neon { --bg-color: #00ff00; --card-bg: #000; --text-main: #fff; --accent-color: #ff00ff; --sec-color: #ffff00; --quest-color: #00ffff; }\r\n        \r\n        body { margin: 0; background-color: var(--bg-color); color: var(--text-main); font-family: 'Cairo', sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; width: 100vw; overflow: hidden; }\r\n\r\n        #game-wrapper { \r\n            width: 100%; height: 100%; display: flex; flex-direction: column; \r\n            justify-content: center; align-items: center;\r\n            transform: scale(var(--zoom-level));\r\n            transition: transform 0.3s ease;\r\n        }\r\n\r\n        /* شاشة الإعدادات */\r\n        #setup-screen { background: var(--card-bg); padding: 15px; border-radius: 20px; border: 4px solid var(--accent-color); text-align: center; width: 90%; max-width: 500px; z-index: 1000; max-height: 90vh; overflow-y: auto; color: var(--text-main); }\r\n        .manual-q-box { border: 1px solid var(--accent-color); padding: 10px; border-radius: 10px; margin-bottom: 15px; background: rgba(255,255,255,0.05); }\r\n        .opt-row { display: grid; grid-template-columns: 30px 1fr auto; gap: 5px; margin-top: 5px; align-items: center; }\r\n        .img-preview { width: 40px; height: 40px; object-fit: cover; border-radius: 5px; border: 1px solid var(--accent-color); display: none; }\r\n        input, select { width: 100%; padding: 5px; border-radius: 5px; border: 1px solid #444; background: #222; color: #fff; }\r\n        .start-btn { background: #D63031; color: white; padding: 12px; font-size: 1.2rem; border-radius: 50px; width: 100%; border: none; cursor: pointer; font-weight: bold; margin-top: 10px; }\r\n\r\n        /* شاشة اللعبة */\r\n        #video-screen { display: none; width: 100vw; height: 100vh; flex-direction: column; justify-content: space-around; align-items: center; padding: 20px; box-sizing: border-box; }\r\n\r\n        /* حركة السؤال */\r\n        @keyframes questionBounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }\r\n        .q-animate { animation: questionBounce 2s ease-in-out infinite; }\r\n        #q-area { display: flex; flex-direction: row-reverse; align-items: center; justify-content: center; gap: 20px; width: 90%; max-height: 30vh; }\r\n        #question-text { font-size: clamp(1.5rem, 5vw, 2.8rem); font-weight: 900; color: var(--quest-color); text-shadow: 2px 2px 0 #000; text-align: center; max-width: 60%; }\r\n        #q-main-img { max-height: 25vh; max-width: 35%; border-radius: 15px; border: 4px solid var(--accent-color); display: none; object-fit: contain; }\r\n\r\n        #timer-box { font-size: 2.8rem; background: var(--sec-color); color: white; width: 90px; height: 90px; border-radius: 50%; display: flex; justify-content: center; align-items: center; border: 5px solid white; box-shadow: 0 0 15px var(--sec-color); }\r\n\r\n        /* الأجوبة */\r\n        .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; width: 95%; max-width: 950px; }\r\n        .option-card { \r\n            background: var(--card-bg); border: 4px solid var(--accent-color);\r\n            border-radius: 15px; position: relative; display: flex; flex-direction: row; \r\n            align-items: center; height: 120px; padding: 0 15px; overflow: hidden; \r\n            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\r\n        }\r\n        .opt-img-display { height: 90px; width: 90px; object-fit: contain; border-radius: 8px; margin-left: 10px; flex-shrink: 0; }\r\n        .option-card span { flex-grow: 1; font-size: clamp(1.1rem, 3vw, 1.8rem); font-weight: 900; text-align: center; }\r\n\r\n        /* رقصة الإجابة الصحيحة */\r\n        @keyframes winnerDance {\r\n            0% { transform: scale(1) rotate(0); }\r\n            25% { transform: scale(1.1) rotate(-3deg); }\r\n            50% { transform: scale(1.1) rotate(3deg); }\r\n            75% { transform: scale(1.1) rotate(-3deg); }\r\n            100% { transform: scale(1.1) rotate(0); }\r\n        }\r\n        .correct-glow { \r\n            background: #00FF00 !important; \r\n            color: #000 !important; \r\n            border-color: #fff !important; \r\n            box-shadow: 0 0 50px #00FF00; \r\n            animation: winnerDance 0.5s ease-in-out infinite; \r\n            z-index: 10;\r\n        }\r\n\r\n        .letter-label { position: absolute; top: -5px; right: -5px; background: var(--quest-color); color: #000; width: 35px; height: 35px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-weight: 900; border: 2px solid white; font-size: 1rem; }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<div id=\"game-wrapper\">\r\n    <div id=\"setup-screen\">\r\n        <h2>🛠️ إعدادات قناة وسام</h2>\r\n        <div style=\"margin-bottom: 15px; background: rgba(255,255,255,0.1); padding: 10px; border-radius: 10px;\">\r\n            <label>حجم العرض: <span id=\"zoom-val\">100</span>%</label>\r\n            <input type=\"range\" min=\"0.5\" max=\"1\" step=\"0.05\" value=\"1\" oninput=\"updateZoom(this.value)\">\r\n        </div>\r\n        <div id=\"manual-container\"></div>\r\n        <button onclick=\"addManualQ()\" style=\"width:100%; padding:8px; background:#27ae60; color:white; border:none; border-radius:5px; cursor:pointer;\">➕ أضف سؤالاً</button>\r\n        <div style=\"display:flex; gap:5px; margin-top:10px;\">\r\n            <button onclick=\"saveToLocal()\" style=\"flex:1; background:#2980b9; color:white; border:none; padding:5px; border-radius:5px;\">💾 حفظ النصوص</button>\r\n            <button onclick=\"clearSaved()\" style=\"flex:1; background:#c0392b; color:white; border:none; padding:5px; border-radius:5px;\">🗑️ مسح</button>\r\n        </div>\r\n        <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:10px;\">\r\n            <select id=\"theme-select\"><option value=\"default\">🌙 نيون</option><option value=\"theme-kids-mickey\">🍎 ميكي</option><option value=\"theme-kids-neon\">🟢 فسفوري</option><option value=\"theme-light\">🌈 مرح</option></select>\r\n            <input type=\"number\" id=\"time-input\" value=\"10\">\r\n        </div>\r\n        <button class=\"start-btn\" onclick=\"startChallenge()\">ابدأ التحدي 🚀</button>\r\n    </div>\r\n\r\n    <div id=\"video-screen\">\r\n        <div id=\"timer-box\">10</div>\r\n        <div id=\"q-area\" class=\"q-animate\">\r\n            <img id=\"q-main-img\">\r\n            <div id=\"question-text\">؟</div>\r\n        </div>\r\n        <div class=\"options-grid\" id=\"options-container\"></div>\r\n        <div style=\"opacity:0.7; font-size:1.3rem; font-weight:bold; color: var(--accent-color);\">قناة وسام التعليمية</div>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\n    let currentStep = 0, config = {}, manualData = [];\r\n    const audioTick = new Audio('https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3');\r\n    const audioWin = new Audio('https://assets.mixkit.co/active_storage/sfx/2019/2019-preview.mp3');\r\n\r\n    function updateZoom(val) {\r\n        document.documentElement.style.setProperty('--zoom-level', val);\r\n        document.getElementById('zoom-val').innerText = Math.round(val * 100);\r\n    }\r\n\r\n    function handleImgPreview(input) {\r\n        const preview = input.nextElementSibling;\r\n        if (input.files && input.files[0]) {\r\n            const reader = new FileReader();\r\n            reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };\r\n            reader.readAsDataURL(input.files[0]);\r\n        }\r\n    }\r\n\r\n    function addManualQ(data = null) {\r\n        const div = document.createElement('div'); div.className = 'manual-q-box';\r\n        div.innerHTML = `\r\n            <input type=\"text\" placeholder=\"السؤال\" class=\"m-q-text\" value=\"${data?data.q:''}\">\r\n            <div style=\"display:flex; align-items:center; gap:10px; margin:5px 0;\"><input type=\"file\" onchange=\"handleImgPreview(this)\" class=\"m-q-img\" accept=\"image/*\" style=\"font-size:0.7rem;\"><img class=\"img-preview\"></div>\r\n            ${[0,1,2,3].map(i => `\r\n                <div class=\"opt-row\">\r\n                    <input type=\"checkbox\" class=\"m-is-correct\" ${data?(data.options[i].isCorrect?'checked':''):(i===0?'checked':'')}>\r\n                    <input type=\"text\" placeholder=\"الجواب\" class=\"m-opt-txt\" value=\"${data?data.options[i].text:''}\">\r\n                    <div style=\"display:flex; align-items:center; gap:5px;\"><input type=\"file\" onchange=\"handleImgPreview(this)\" class=\"m-opt-img\" accept=\"image/*\" style=\"width:70px; font-size:0.5rem;\"><img class=\"img-preview\"></div>\r\n                </div>`).join('')}`;\r\n        document.getElementById('manual-container').appendChild(div);\r\n    }\r\n\r\n    function saveToLocal() {\r\n        const boxes = Array.from(document.querySelectorAll('.manual-q-box'));\r\n        const data = boxes.map(box => ({\r\n            q: box.querySelector('.m-q-text').value,\r\n            options: Array.from(box.querySelectorAll('.opt-row')).map(row => ({\r\n                text: row.querySelector('.m-opt-txt').value,\r\n                isCorrect: row.querySelector('.m-is-correct').checked\r\n            }))\r\n        }));\r\n        localStorage.setItem('wesam_final_v7', JSON.stringify(data));\r\n        alert(\"تم الحفظ!\");\r\n    }\r\n\r\n    function loadSaved() {\r\n        const saved = localStorage.getItem('wesam_final_v7');\r\n        if (saved) JSON.parse(saved).forEach(item => addManualQ(item));\r\n        else addManualQ();\r\n    }\r\n\r\n    function speak(text) {\r\n        window.speechSynthesis.cancel();\r\n        const msg = new SpeechSynthesisUtterance(text);\r\n        msg.lang = 'ar-SA';\r\n        window.speechSynthesis.speak(msg);\r\n    }\r\n\r\n    async function startChallenge() {\r\n        document.body.className = document.getElementById('theme-select').value;\r\n        config.time = parseInt(document.getElementById('time-input').value);\r\n        const boxes = document.querySelectorAll('.manual-q-box');\r\n        manualData = [];\r\n        for (let box of boxes) {\r\n            let opts = [];\r\n            const rows = box.querySelectorAll('.opt-row');\r\n            for(let row of rows) {\r\n                const img = row.querySelector('.m-opt-img').files[0];\r\n                opts.push({ text: row.querySelector('.m-opt-txt').value, img: img ? await toBase64(img) : null, isCorrect: row.querySelector('.m-is-correct').checked });\r\n            }\r\n            const qImg = box.querySelector('.m-q-img').files[0];\r\n            manualData.push({ q: box.querySelector('.m-q-text').value, qImg: qImg ? await toBase64(qImg) : null, options: opts });\r\n        }\r\n        document.getElementById('setup-screen').style.display = 'none';\r\n        document.getElementById('video-screen').style.display = 'flex';\r\n        playStep();\r\n    }\r\n\r\n    function toBase64(f) { return new Promise(r => { const rd = new FileReader(); rd.onload = e => r(e.target.result); rd.readAsDataURL(f); }); }\r\n\r\n    function playStep() {\r\n        if (currentStep >= manualData.length) { document.getElementById('video-screen').innerHTML = \"<h1>كفو! انتهى التحدي 🏆</h1>\"; return; }\r\n        let data = manualData[currentStep];\r\n        document.getElementById('question-text').innerText = data.q || \"\";\r\n        const qImgEl = document.getElementById('q-main-img');\r\n        if(data.qImg) { qImgEl.src = data.qImg; qImgEl.style.display = 'block'; } else qImgEl.style.display = 'none';\r\n\r\n        const container = document.getElementById('options-container'); container.innerHTML = '';\r\n        let correctVal = \"\";\r\n\r\n        data.options.forEach((opt, i) => {\r\n            const card = document.createElement('div'); card.className = 'option-card';\r\n            if(opt.isCorrect) { card.classList.add('is-correct-target'); correctVal = opt.text; }\r\n            let imgHtml = opt.img ? `<img src=\"${opt.img}\" class=\"opt-img-display\">` : '';\r\n            card.innerHTML = `<div class=\"letter-label\">${['أ','ب','ج','د'][i]}</div>${imgHtml}<span>${opt.text || ''}</span>`;\r\n            container.appendChild(card);\r\n        });\r\n\r\n        speak(data.q || \"ما هو الجواب؟\");\r\n        let timer = config.time;\r\n        document.getElementById('timer-box').innerText = timer;\r\n        let inter = setInterval(() => {\r\n            timer--; document.getElementById('timer-box').innerText = timer;\r\n            audioTick.play();\r\n            if(timer <= 0) {\r\n                clearInterval(inter); audioWin.play();\r\n                document.querySelectorAll('.is-correct-target').forEach(el => el.classList.add('correct-glow'));\r\n                speak(\"الإجابة الصحيحة هي \" + correctVal);\r\n                setTimeout(() => { currentStep++; playStep(); }, 4000);\r\n            }\r\n        }, 1000);\r\n    }\r\n    window.onload = loadSaved;\r\n    function clearSaved() { localStorage.removeItem('wesam_final_v7'); location.reload(); }\r\n</script>\r\n</body>\r\n</html>"
  },
